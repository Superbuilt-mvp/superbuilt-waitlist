# Required env vars — names MUST match exactly (some are camelCase, intentionally).
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/superbuilt
jwt_secret=replace-with-a-strong-secret
accessExpirationMinutes=1440
googleClientId=your-google-oauth-client-id
googleClientSecret=your-google-oauth-client-secret
redirectUri=https://www.superbuilt.ai/api/auth/google/callback
frontendUrl=https://www.superbuilt.ai

# Optional
PORT=8080
